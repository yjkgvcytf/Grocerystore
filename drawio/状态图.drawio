        </mxCell>
        <mxCell id="e_shipped_delivered" edge="1" parent="1" source="shipped" style="endArrow=block;html=1;rounded=0;fontSize=12;" target="delivered" value="заказ доставлен">
          <mxGeometry relative="1" as="geometry" />
