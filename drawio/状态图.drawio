          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pending_cancelled" edge="1" parent="1" source="pending" style="endArrow=block;html=1;rounded=0;fontSize=12;" target="cancelled" value="отмена заказа">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="215" />
