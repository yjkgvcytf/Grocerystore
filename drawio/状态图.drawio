<mxfile host="app.diagrams.net" agent="Cursor">
  <diagram id="order-state-diagram" name="Order State Diagram">
    <mxGraphModel dx="2054" dy="1113" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="610" y="95" as="geometry" />
        </mxCell>
        <mxCell id="pending" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;" value="PENDING&#xa;Ожидает обработки" vertex="1">
          <mxGeometry height="70" width="220" x="520" y="180" as="geometry" />
        </mxCell>
        <mxCell id="processing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" value="PROCESSING&#xa;Обрабатывается" vertex="1">
          <mxGeometry height="70" width="220" x="520" y="320" as="geometry" />
        </mxCell>
        <mxCell id="shipped" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" value="SHIPPED&#xa;Отправлен" vertex="1">
          <mxGeometry height="70" width="220" x="520" y="460" as="geometry" />
        </mxCell>
        <mxCell id="delivered" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" value="DELIVERED&#xa;Доставлен" vertex="1">
          <mxGeometry height="70" width="220" x="520" y="600" as="geometry" />
        </mxCell>
        <mxCell id="cancelled" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;" value="CANCELLED&#xa;Отменен" vertex="1">
          <mxGeometry height="70" width="220" x="840" y="350" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="610" y="740" as="geometry" />
        </mxCell>
        <mxCell id="note_create" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="{Заказ создается методом&#xa;OrderService.createOrder()}&#xa;Начальный статус: PENDING" vertex="1">
          <mxGeometry height="100" width="230" x="190" y="170" as="geometry" />
        </mxCell>
        <mxCell id="note_update" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="{Статус обновляется методом&#xa;OrderService.updateOrderStatus()}&#xa;Строгая проверка порядка переходов&#xa;в коде не реализована" vertex="1">
          <mxGeometry height="120" width="300" x="970" y="190" as="geometry" />
        </mxCell>
        <mxCell id="e_start_pending" edge="1" parent="1" source="start" style="endArrow=block;html=1;rounded=0;fontSize=12;" target="pending" value="createOrder()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pending_processing" edge="1" parent="1" source="pending" style="endArrow=block;html=1;rounded=0;fontSize=12;" target="processing" value="принят в обработку">
